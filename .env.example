# ── Database — development (docker-compose.yml / start-dev.ps1) ───────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ballastlane
DB_USER=ballastlane
DB_PASSWORD=ballastlane_dev

# ── Database — test (docker-compose.test.yml) ─────────────────────────────────
TEST_DB_HOST=localhost
TEST_DB_PORT=5433
TEST_DB_NAME=ballastlane_test
TEST_DB_USER=ballastlane_test
TEST_DB_PASSWORD=ballastlane_test

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-256-bit-random-secret-before-production
JWT_EXPIRY_MINUTES=60

# ── Host ports for Docker (docker compose up) ─────────────────────────────────
# Change any of these if the default port is already in use on your machine.
# These only affect which ports are exposed to your host — nothing inside Docker changes.
APP_PORT=3000      # Frontend  → http://localhost:3000
API_PORT=5000      # API       → http://localhost:5000  (Swagger: /swagger)
PGADMIN_PORT=5050  # pgAdmin   → http://localhost:5050
